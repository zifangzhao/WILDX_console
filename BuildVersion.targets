<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="IncrementWildXBuildVersion" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)bump_version.ps1&quot;" />
  </Target>
</Project>
